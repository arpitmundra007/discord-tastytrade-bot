# --- Safety ---
# true = parse + risk-check + log only, no order sent
DRY_RUN=true

# --- Discord (self-bot mode - automates your own personal account) ---
# This is against Discord's ToS regardless of read-only use, and puts your
# whole account at risk. See README before using.
DISCORD_USER_TOKEN=
# comma-separated channel IDs, e.g. 111111111,222222222
DISCORD_SIGNAL_CHANNEL_IDS=

# --- Tastytrade OAuth ---
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
# e.g. 5WX01234
TT_ACCOUNT_NUMBER=
# switch to https://api.tastyworks.com for live
TT_BASE_URL=https://api.cert.tastyworks.com

# --- Risk: slippage protection ---
# Max allowed difference between signal price and live market price, as a %.
# Order is skipped (not resubmitted at a worse price) if exceeded.
MAX_SLIPPAGE_PCT=10

# --- Risk: position sizing mode ---
# "tag" = contract count from SIZE_TAG_MAP below, matched against each
#   signal's own size/risk tag (e.g. SMALL, LOTTO)
# "budget" = ignores tags entirely; buys the most contracts that fit at or
#   under BUDGET_USD, based on the live price at execution
SIZING_MODE=tag
BUDGET_USD=300

# --- Risk: position sizing by signal size tag (case-insensitive match) ---
# Only used when SIZING_MODE=tag. Format: TAG:CONTRACTS,TAG:CONTRACTS,...
SIZE_TAG_MAP=SMALL:1,MEDIUM:3,LARGE:5,LOTTO:1
# used if no tag matches
DEFAULT_CONTRACTS=1
# absolute ceiling regardless of sizing mode - safety net
MAX_CONTRACTS_HARD_CAP=2

# --- Risk: take profit / stop loss (% of entry premium) ---
# close at +50% of entry price
TAKE_PROFIT_PCT=50
# close at -50% of entry price
STOP_LOSS_PCT=50

# --- Logging ---
DB_PATH=./trades.db
